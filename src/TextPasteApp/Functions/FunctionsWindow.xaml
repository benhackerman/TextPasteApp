<Window x:Class="TextPasteApp.Functions.FunctionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TextPaste — Funciones"
        SizeToContent="WidthAndHeight" MinWidth="460" MaxWidth="820"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <!-- Buscador compacto de funciones guardadas. Resultados, parámetros y vista previa se arman en el .cs -->
    <Border Margin="8" Padding="8,6,8,8" CornerRadius="10" Background="#F516181E" BorderBrush="#FF2D3240" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.4" />
        </Border.Effect>
        <StackPanel>
            <Grid Height="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Placeholder" Text="Buscar función…" Margin="4,0,0,0" VerticalAlignment="Center"
                           FontSize="13" Foreground="#FF6B7280" IsHitTestVisible="False" />
                <TextBox x:Name="SearchBox" VerticalAlignment="Center" MinWidth="200"
                         Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White"
                         FontFamily="Consolas" FontSize="14" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,2,0">
                    <TextBlock x:Name="RowText" Foreground="#FF3DDC97" FontSize="11" Margin="0,0,8,0" MaxWidth="220"
                               TextTrimming="CharacterEllipsis" ToolTip="Los parámetros con el nombre de una columna se rellenan con esta fila del taglist" />
                    <TextBlock x:Name="CountText" Foreground="#FFB98CFF" FontSize="11" FontWeight="Bold" />
                </StackPanel>
            </Grid>
            <Border Height="1" Background="#FF2D3240" Margin="0,4,0,4" />
            <StackPanel x:Name="ResultsPanel" Grid.IsSharedSizeScope="True" />
            <TextBlock x:Name="EmptyText" Foreground="#FF9AA0AA" FontSize="12" TextWrapping="Wrap" MaxWidth="440"
                       Margin="4,4,4,2" Visibility="Collapsed" />
            <WrapPanel x:Name="ParamsPanel" Margin="2,6,0,0" MaxWidth="780" />
            <Border x:Name="PreviewBorder" Background="#FF0F1115" CornerRadius="6" Padding="8,6" Margin="0,6,0,0">
                <TextBlock x:Name="PreviewText" FontFamily="Consolas" FontSize="12" Foreground="#FFD7DAE0"
                           ToolTip="Enter pega · ↑↓ elegir · Tab ir a parámetros y variables · Ctrl+N nueva desde lo copiado · Ctrl+E editar · Esc" />
            </Border>
        </StackPanel>
    </Border>
</Window>
