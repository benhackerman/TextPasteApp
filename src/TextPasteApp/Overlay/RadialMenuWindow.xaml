<Window x:Class="TextPasteApp.Overlay.RadialMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TextPaste"
        Width="400" Height="470"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        FontFamily="Segoe UI" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <!-- Todo se dibuja desde RadialMenuWindow.xaml.cs (Render). Aquí sólo están las capas fijas. -->
    <Canvas x:Name="Root" Width="400" Height="470">
        <Canvas x:Name="Drawing" Width="400" Height="470" />
        <TextBox x:Name="SearchBox" Width="170" Height="24" Visibility="Collapsed"
                 FontSize="12" Padding="6,2" VerticalContentAlignment="Center"
                 Background="#FF14161B" Foreground="White" CaretBrush="White"
                 BorderBrush="#FF3A3F4B" BorderThickness="1" />
    </Canvas>
</Window>
