<Window x:Class="TextPasteApp.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TextPaste — Configuración" Width="780" Height="600" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13">
    <DockPanel>
        <!-- Encabezado -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="18,12">
            <StackPanel>
                <TextBlock Text="TextPaste" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="HeaderHint" Foreground="#FF9AA0AA" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- Barra inferior -->
        <Border DockPanel.Dock="Bottom" Padding="14,10" BorderBrush="#FFE5E7EB" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Guardar" IsDefault="True" Click="Save_Click" FontWeight="SemiBold" />
                    <Button Content="Cancelar" IsCancel="True" Click="Cancel_Click" Margin="0" />
                </StackPanel>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <TabControl Margin="12" Padding="14">
            <!-- ═══════════ General ═══════════ -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="Atajos" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Help}"
                                   Text="Haz clic en un cuadro y presiona la combinación. Ruleta: mantén para abrir y suelta para pegar. Taglist: abre el buscador directo." />
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Ruleta (historial / favoritos)" Margin="0,0,0,4" />
                                <TextBox x:Name="HotkeyBox" Tag="ring" Width="240" IsReadOnly="True" FontWeight="SemiBold" Cursor="Hand"
                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                         GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Taglist (buscador)" Margin="0,0,0,4" />
                                <TextBox x:Name="TaglistHotkeyBox" Tag="taglist" Width="240" IsReadOnly="True" FontWeight="SemiBold" Cursor="Hand"
                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                         GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Apariencia" Style="{StaticResource SectionTitle}" Margin="0,18,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Opacidad (ruleta y taglist):" VerticalAlignment="Center" Width="170" />
                            <Slider x:Name="OpacitySlider" Width="220" Minimum="40" Maximum="100" TickFrequency="5"
                                    IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Opacity_Changed" />
                            <TextBlock x:Name="OpacityText" Width="50" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Help}" Margin="0,4,0,0"
                                   Text="También se ajusta con Ctrl + rueda con el taglist abierto." />

                        <TextBlock Text="Comportamiento" Style="{StaticResource SectionTitle}" Margin="0,18,0,6" />
                        <CheckBox x:Name="TapToStickBox"
                                  Content="Un toque rápido del atajo deja la ruleta abierta con buscador" />
                        <CheckBox x:Name="RestoreClipboardBox"
                                  Content="Después de pegar, devolver al portapapeles lo que había antes" />
                        <CheckBox x:Name="PersistHistoryBox" Content="Guardar el historial al cerrar" />
                        <CheckBox x:Name="StartWithWindowsBox" Content="Iniciar con Windows" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Textos en el historial:" VerticalAlignment="Center" Width="170" />
                            <TextBox x:Name="HistoryLimitBox" Width="70" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Sectores por página:" VerticalAlignment="Center" Width="170" />
                            <ComboBox x:Name="SlicesBox" Width="70" />
                        </StackPanel>

                        <TextBlock Text="Historial actual" Style="{StaticResource SectionTitle}" Margin="0,18,0,6" />
                        <ListBox x:Name="HistoryList" Height="140" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="★ Pasar a favoritos" Click="HistoryToFavorite_Click" />
                            <Button Content="Borrar historial" Click="ClearHistory_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════ Favoritos ═══════════ -->
            <TabItem Header="Favoritos">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Help}"
                               Text="Textos fijos que siempre aparecen en la ruleta. El nombre corto es lo que se ve en el sector; si lo dejas vacío se muestra el texto." />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="▲ Subir" Click="FavoriteUp_Click" />
                        <Button Content="▼ Bajar" Click="FavoriteDown_Click" />
                        <Button Content="Eliminar" Click="FavoriteDelete_Click" />
                    </StackPanel>
                    <DataGrid x:Name="FavoritesGrid" AutoGenerateColumns="False" CanUserAddRows="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="26">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre corto" Binding="{Binding Label}" Width="180" />
                            <DataGridTextColumn Header="Texto a pegar" Binding="{Binding Text}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ═══════════ Taglist ═══════════ -->
            <TabItem Header="Taglist">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Help}"
                               Text="Un perfil describe cómo es tu taglist: qué hojas usar, en qué fila están los encabezados y qué columna se pega por defecto. Configúralo una vez; en cada proyecto nuevo sólo cambias el archivo. El archivo se relee solo cuando cambia." />
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Perfil:" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" x:Name="ProfileBox" Margin="0,2" SelectionChanged="Profile_Changed" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,2,0,2">
                            <Button Content="Nuevo" Click="ProfileNew_Click" MinWidth="0" />
                            <Button Content="Duplicar" Click="ProfileDuplicate_Click" MinWidth="0" />
                            <Button Content="Eliminar" Click="ProfileDelete_Click" MinWidth="0" />
                            <Button Content="Exportar…" Click="ProfileExport_Click" MinWidth="0" />
                            <Button Content="Importar…" Click="ProfileImport_Click" MinWidth="0" Margin="0" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="Nombre:" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="ProfileNameBox" Margin="0,2" LostFocus="ProfileName_LostFocus" />

                        <TextBlock Grid.Row="2" Text="Archivo:" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="FilePathBox" Margin="0,2" />
                        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="6,2,0,2">
                            <Button Content="Examinar…" Click="Browse_Click" MinWidth="0" />
                            <Button Content="Detectar hojas" Click="Detect_Click" FontWeight="SemiBold" MinWidth="0" Margin="0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Help}" Margin="0,10,0,4"
                               Text="Columnas: escribe el encabezado tal como está en el Excel o la letra (A, B…). «Columnas visibles» separadas por coma; vacío = todas. El orden de las filas define Ctrl+1…9." />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="▲ Subir" Click="SheetUp_Click" />
                        <Button Content="▼ Bajar" Click="SheetDown_Click" />
                        <Button Content="Vista previa" Click="Preview_Click" FontWeight="SemiBold" />
                    </StackPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="SheetsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="26">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Usar" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="45" />
                                <DataGridTextColumn Header="Hoja del Excel" Binding="{Binding SheetName}" IsReadOnly="True" Width="150" />
                                <DataGridTextColumn Header="Corto" Binding="{Binding ShortName}" Width="60" />
                                <DataGridTextColumn Header="Fila encab." Binding="{Binding HeaderRow}" Width="70" />
                                <DataGridTextColumn Header="Columna a pegar" Binding="{Binding PasteColumn}" Width="120" />
                                <DataGridTextColumn Header="Columnas visibles" Binding="{Binding VisibleColumns}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid Grid.Row="1" x:Name="PreviewGrid" Margin="0,8,0,0" IsReadOnly="True" AutoGenerateColumns="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" />
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ═══════════ Plantillas ═══════════ -->
            <TabItem Header="Plantillas">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Help}">
                        Envuelven el texto antes de pegarlo. Se cambian con clic derecho (o T / F2) en la ruleta.
                        <LineBreak />
                        Marcadores: <Bold>{valor}</Bold> valor a pegar · <Bold>{tag}</Bold> · <Bold>{desc}</Bold> ·
                        <Bold>{NombreColumna}</Bold> cualquier columna visible del Excel · <Bold>{valor:0000}</Bold> rellena con ceros.
                        <LineBreak />
                        En el taglist, <Bold>{valor}</Bold> es la columna elegida con la rueda (por defecto, la «columna a pegar» de la hoja).
                    </TextBlock>
                    <Border DockPanel.Dock="Bottom" Background="#FFF3F4F6" CornerRadius="6" Padding="10" Margin="0,8,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Probar con  valor:" VerticalAlignment="Center" />
                                <TextBox x:Name="SampleValueBox" Width="90" Margin="6,0" Text="23" TextChanged="Sample_Changed" />
                                <TextBlock Text="tag:" VerticalAlignment="Center" />
                                <TextBox x:Name="SampleTagBox" Width="110" Margin="6,0" Text="XV-1023" TextChanged="Sample_Changed" />
                            </StackPanel>
                            <TextBlock x:Name="TemplatePreview" Margin="0,8,0,0" FontFamily="Consolas" FontSize="14"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="▲ Subir" Click="TemplateUp_Click" />
                        <Button Content="▼ Bajar" Click="TemplateDown_Click" />
                        <Button Content="Eliminar" Click="TemplateDelete_Click" />
                    </StackPanel>
                    <DataGrid x:Name="TemplatesGrid" AutoGenerateColumns="False" CanUserAddRows="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="26"
                              SelectionChanged="Templates_SelectionChanged" CellEditEnding="Templates_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="200" />
                            <DataGridTextColumn Header="Patrón" Binding="{Binding Pattern}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
