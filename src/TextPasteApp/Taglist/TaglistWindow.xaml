<Window x:Class="TextPasteApp.Taglist.TaglistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TextPaste — Taglist"
        Width="660" Height="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <!-- El contenido de pestañas, resultados y columnas se arma en TaglistWindow.xaml.cs (Render). -->
    <Border Margin="10" Padding="18" CornerRadius="22" Background="#FF16181E" BorderBrush="#FF2D3240" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="Ctrl+Tab: ruleta" Foreground="#FF9AA0AA" FontSize="11" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="TAGLIST" Foreground="#FF3DDC97" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock x:Name="ProfileText" Foreground="#FF9AA0AA" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="420" />
                </StackPanel>
            </DockPanel>

            <!-- Hojas -->
            <WrapPanel x:Name="SheetsPanel" Grid.Row="1" Margin="0,10,0,10" />

            <!-- Buscador con autocompletar -->
            <Border Grid.Row="2" Height="44" CornerRadius="10" Background="#FF0F1115" BorderBrush="#FF3A3F4B" BorderThickness="1">
                <Grid>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FF9AA0AA"
                               Margin="14,0,0,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="GhostText" Margin="42,0,12,0" VerticalAlignment="Center"
                               FontFamily="Consolas" FontSize="15" IsHitTestVisible="False" />
                    <TextBlock x:Name="Placeholder" Text="Escribe tag, n°, descripción…" Margin="42,0,12,0" VerticalAlignment="Center"
                               FontSize="14" Foreground="#FF6B7280" IsHitTestVisible="False" />
                    <TextBox x:Name="SearchBox" Margin="38,0,12,0" VerticalAlignment="Center"
                             Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White"
                             FontFamily="Consolas" FontSize="15" />
                </Grid>
            </Border>

            <!-- Resultados | fila completa -->
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <DockPanel>
                    <TextBlock x:Name="CountText" DockPanel.Dock="Top" Foreground="#FF9AA0AA" FontSize="11" Margin="4,0,0,6"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel x:Name="ResultsPanel" />
                </DockPanel>
                <Border Grid.Column="2" CornerRadius="12" Background="#FF1E2129" Padding="10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Fila completa · la rueda elige la columna" Foreground="#FF9AA0AA"
                                   FontSize="11" Margin="4,0,0,6" />
                        <ScrollViewer x:Name="FieldsScroll" VerticalScrollBarVisibility="Hidden" Focusable="False">
                            <StackPanel x:Name="FieldsPanel" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Lo que se va a pegar -->
            <Border Grid.Row="4" BorderBrush="#FF2D3240" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
                <DockPanel>
                    <Button x:Name="TemplateButton" DockPanel.Dock="Right" Padding="12,4" Focusable="False" Cursor="Hand"
                            Foreground="#FF3DDC97" Background="Transparent" BorderBrush="#FF3DDC97" FontSize="12" />
                    <TextBlock x:Name="PreviewText" Foreground="#FF3DDC97" FontFamily="Consolas" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                </DockPanel>
            </Border>

            <TextBlock Grid.Row="5" Margin="0,8,0,0" HorizontalAlignment="Center" Foreground="#FF9AA0AA" FontSize="11"
                       Text="Enter pegar · ↑↓ fila · Rueda columna · → autocompletar · Tab hoja · Ctrl+1…9 hoja · Ctrl+Rueda opacidad · Esc" />
        </Grid>
    </Border>
</Window>
