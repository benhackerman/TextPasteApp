<Window x:Class="TextPasteApp.Taglist.TaglistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TextPaste — Taglist"
        SizeToContent="WidthAndHeight" MinWidth="380" MaxWidth="820"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <!-- Vista compacta: una línea de búsqueda y la tabla de resultados. Las filas se arman en Render(). -->
    <Border Margin="8" Padding="8,6,8,8" CornerRadius="10" Background="#F516181E" BorderBrush="#FF2D3240" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.4" />
        </Border.Effect>
        <StackPanel>
            <!-- Búsqueda: lo que escribes + autocompletado en gris | hoja y cantidad -->
            <Grid Height="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="GhostText" Margin="4,0,0,0" VerticalAlignment="Center"
                           FontFamily="Consolas" FontSize="14" IsHitTestVisible="False" />
                <TextBlock x:Name="Placeholder" Text="Buscar tag, n°, texto…  (↑↓ fila · ←→ columna · F3 formato · Enter pega)" Margin="4,0,0,0" VerticalAlignment="Center"
                           FontSize="13" Foreground="#FF6B7280" IsHitTestVisible="False" />
                <TextBox x:Name="SearchBox" VerticalAlignment="Center" MinWidth="200"
                         Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White"
                         FontFamily="Consolas" FontSize="14" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,2,0">
                    <TextBlock x:Name="ProjectText" Foreground="#FF9AA0AA" FontSize="11" Margin="0,0,8,0" Cursor="Hand"
                               MaxWidth="160" TextTrimming="CharacterEllipsis" ToolTip="F4: cambiar de proyecto" />
                    <TextBlock x:Name="ProgressText" Foreground="#FF9AA0AA" FontSize="11" Margin="0,0,8,0"
                               ToolTip="Filas hechas / total · Ctrl+D marca o desmarca" />
                    <TextBlock x:Name="TemplateText" Foreground="#FF3DDC97" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"
                               Margin="0,0,10,0" Visibility="Collapsed" />
                    <TextBlock x:Name="SheetText" Foreground="#FF3DDC97" FontSize="11" FontWeight="Bold" Cursor="Hand"
                               ToolTip="Tab: cambiar de hoja · Ctrl+1…9: hoja directa" />
                </StackPanel>
            </Grid>
            <!-- F3: formato al pegar de la hoja actual (se guarda en el perfil) -->
            <Grid x:Name="FormatEditor" Margin="0,4,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FormatLabel" Foreground="#FF9AA0AA" FontSize="11" VerticalAlignment="Center" Margin="4,0,8,0" />
                <TextBox x:Name="FormatBox" Grid.Column="1" Background="#FF0F1115" Foreground="White" CaretBrush="White"
                         BorderBrush="#FF3DDC97" FontFamily="Consolas" FontSize="13" Padding="4,2" />
                <TextBlock x:Name="FormatExample" Grid.Column="2" Foreground="#FF3DDC97" FontFamily="Consolas" FontSize="12"
                           VerticalAlignment="Center" Margin="8,0,4,0" />
            </Grid>
            <Border Height="1" Background="#FF2D3240" Margin="0,4,0,4" />
            <!-- Tabla: encabezados + filas (columnas alineadas con SharedSizeGroup) -->
            <StackPanel x:Name="Table" Grid.IsSharedSizeScope="True" />
            <TextBlock x:Name="SequenceText" Foreground="#FF9AA0AA" FontSize="11" Margin="6,4,4,0" Visibility="Collapsed"
                       TextTrimming="CharacterEllipsis" MaxWidth="700" />
            <TextBlock x:Name="EmptyText" Foreground="#FF9AA0AA" FontSize="12" TextWrapping="Wrap" MaxWidth="420"
                       Margin="4,4,4,2" Visibility="Collapsed" />
        </StackPanel>
    </Border>
</Window>
